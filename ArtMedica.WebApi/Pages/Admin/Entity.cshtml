@page
@model ArtMedica.WebApi.Pages.Admin.ListModel

<link rel="stylesheet" href="~/admin.css" asp-append-version="true" />

@{
    ViewData["Title"] = Model.Definition.Label;
}

<div class="admin-layout">

    @await Html.PartialAsync(
        "_AdminSidebar",
        Model.Entities
    )

    <main class="admin-main">
    <div class="admin-page">
    <div class="admin-header">
        <div>
            <div class="admin-breadcrumb">
                Администрирование / @Model.Definition.Label
            </div>

            <h1 class="admin-title">
                @Model.Definition.Label
            </h1>

            <p class="admin-subtitle">
                Список записей сущности
            </p>
        </div>

        <a class="admin-button admin-button-primary" asp-page="/Admin/Create" asp-route-entity="@Model.EntityRoute">

            <span class="button-icon">+</span>
            Создать
        </a>
    </div>


    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h2>Записи</h2>

                <span class="admin-count">
                    @Model.Items.Count записей
                </span>
            </div>
        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="admin-empty">
                <div class="empty-icon">
                    ○
                </div>

                <h3>Записей пока нет</h3>

                <p>
                    Создайте первую запись этой сущности.
                </p>

                <a class="admin-button admin-button-primary" asp-page="/Admin/Create" asp-route-entity="@Model.EntityRoute">
                    Создать запись
                </a>
            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>
                        <tr>
                            @foreach (var field in Model.Definition.Fields)
                            {
                                <th>
                                    @field.Label
                                </th>
                            }

                            <th class="actions-column">
                                Действия
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var entity in Model.Items)
                        {
                            <tr>
                                @foreach (var field in Model.Definition.Fields)
                                {
                                    <td>
                                        @(field.GetValue(entity)?.ToString() ?? "—")
                                    </td>
                                }

                                <td class="actions-cell">
                                    <div class="action-buttons">

                                        <a class="action-button action-edit" asp-page="/Admin/Update"
                                           asp-route-entity="@Model.EntityRoute" asp-route-id="@Model.GetId(entity)">
                                            Изменить
                                        </a>

                                        <form method="post" asp-page-handler="Delete" asp-route-entity="@Model.EntityRoute"
                                              asp-route-id="@Model.GetId(entity)"
                                              onsubmit="return confirm('Вы уверены, что хотите удалить эту запись?');">

                                            <button type="submit" class="action-button action-delete">
                                                Удалить
                                            </button>

                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </div>
    </div>
    </main>

</div>