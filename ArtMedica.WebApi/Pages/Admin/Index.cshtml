
@page
@model IndexModel
<link rel="stylesheet" href="~/admin.css" asp-append-version="true" />
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Админ-панель</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

</head>
<body>
    <div class="admin-layout">

        <aside class="sidebar">
            <div class="sidebar-title">
                ArtMedica
            </div>

            <div class="sidebar-caption">
                Управление данными
            </div>

            <nav>
                @foreach (var entity in Model.Entities)
                {
                    <a class="entity-link"
                       asp-page="/Admin/Entity"
                       asp-route-entity="@entity.Route">
                        @entity.Label
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                Панель администратора
            </div>
        </aside>

        <main class="main-content">
            <div class="welcome-card">
                <h1>Админ-панель</h1>

                <p class="welcome-description">
                    Добро пожаловать в панель управления ArtMedica.
                    Здесь вы можете просматривать, создавать и редактировать
                    записи различных сущностей приложения.
                </p>

                <hr />

                <h5>Инструкция по использованию</h5>

                <ol class="instruction-list">
                    <li>
                        <strong>Выберите сущность.</strong>
                        Воспользуйтесь меню слева, чтобы открыть список
                        записей нужного типа.
                    </li>
                    <li>
                        <strong>Просматривайте записи.</strong>
                        В открывшемся списке вы сможете ознакомиться
                        с существующими данными.
                    </li>
                    <li>
                        <strong>Создавайте новые записи.</strong>
                        Используйте соответствующую кнопку на странице
                        сущности для добавления данных.
                    </li>
                    <li>
                        <strong>Редактируйте данные.</strong>
                        Откройте нужную запись, чтобы изменить её поля,
                        если такая возможность предусмотрена.
                    </li>
                </ol>

                <p class="welcome-description mb-0">
                    Для начала работы выберите сущность в меню слева.
                </p>
            </div>
        </main>

    </div>
</body>
</html>